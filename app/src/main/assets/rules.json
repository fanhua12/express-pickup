{
  "version": 2,
  "rules": [
    {
      "name": "横杠格口码",
      "enabled": true,
      "pattern": "(?:取件码|取货码|提货码|凭码|取件口令|凭)[是为：:\\s]*([0-9]{1,4}(?:-[0-9]{1,4}){1,3})"
    },
    {
      "name": "取件码+纯数字",
      "enabled": true,
      "pattern": "(?:取件码|取货码|提货码|提取码|验证码|凭码|取件口令)[是为：:\\s]*([0-9]{4,12})"
    },
    {
      "name": "取件码+字母数字",
      "enabled": true,
      "pattern": "(?:取件码|取货码|提货码|提取码|凭码|取件口令)[是为：:\\s]*((?=[0-9A-Za-z-]*[A-Za-z])[A-Za-z0-9]{2,8}(?:-[A-Za-z0-9]{2,8})?)"
    },
    {
      "name": "凭+字母缩写码",
      "enabled": true,
      "pattern": "凭[是为：:\\s]*((?=[0-9A-Za-z-]*[A-Za-z])[A-Za-z0-9]{1,8}(?:-[A-Za-z0-9]{1,8}){0,3})"
    },
    {
      "name": "凭+纯数字",
      "enabled": true,
      "pattern": "凭([0-9]{4,12})"
    },
    {
      "name": "柜/驿站附近8-12位数字",
      "enabled": true,
      "pattern": "([0-9]{8,12})(?=[^0-9]{0,12}(?:丰巢|柜|驿站|取件))"
    }
  ]
}