{
  "version": 3,
  "rules": [
    {
      "name": "横杠格口码",
      "enabled": true,
      "pattern": "(?:取件码|取货码|提货码|提取码|凭码|取件口令|取件密码|凭)[是为：:\\s]*([0-9A-Za-z]{1,4}(?:-[0-9A-Za-z]{1,6}){1,3})"
    },
    {
      "name": "取件码+纯数字",
      "enabled": true,
      "pattern": "(?:取件码|取货码|提货码|提取码|验证码|凭码|取件口令|取件密码)[是为：:\\s]*([0-9]{4,12})"
    },
    {
      "name": "取件码+字母数字",
      "enabled": true,
      "pattern": "(?:取件码|取货码|提货码|提取码|凭码|取件口令|取件密码)[是为：:\\s]*((?=[0-9A-Za-z-]*[A-Za-z])[0-9A-Za-z]{1,10}(?:-[0-9A-Za-z]{1,6}){0,3})"
    },
    {
      "name": "凭+字母缩写码",
      "enabled": true,
      "pattern": "凭[是为：:\\s]*((?=[0-9A-Za-z-]*[A-Za-z])[0-9A-Za-z]{1,10}(?:-[0-9A-Za-z]{1,6}){0,3})"
    },
    {
      "name": "凭+纯数字",
      "enabled": true,
      "pattern": "凭([0-9]{4,12})"
    },
    {
      "name": "柜/驿站附近8-12位数字",
      "enabled": true,
      "pattern": "([0-9]{8,12})(?=[^0-9]{0,12}(?:丰巢|柜|驿站|取件))"
    },
    {
      "name": "字母格口号-前置语境",
      "enabled": true,
      "pattern": "(?:取件|取货|提货|包裹|驿站|快件|签收|格口|柜|凭)[^0-9A-Za-z]{0,8}([A-Za-z][0-9A-Za-z]{0,3}(?:-[0-9A-Za-z]{1,6}){1,3})"
    },
    {
      "name": "字母格口号-后置语境",
      "enabled": true,
      "pattern": "([A-Za-z][0-9A-Za-z]{0,3}(?:-[0-9A-Za-z]{1,6}){1,3})(?=[^0-9A-Za-z]{0,8}(?:取件|取货|提货|包裹|驿站|快件|签收|格口|柜))"
    },
    {
      "name": "驿站附近横杠码",
      "enabled": true,
      "pattern": "(?:柜|驿站|格口|取件|取货|包裹)[^0-9A-Za-z]{0,8}([0-9]{1,4}(?:-[0-9]{1,6}){1,3})"
    },
    {
      "name": "字母数字混合码-语境",
      "enabled": true,
      "pattern": "(?:取件|取货|提货|包裹|驿站|快件|签收|格口)[^0-9A-Za-z]{0,8}((?=[0-9A-Za-z]{2,10}?[^0-9A-Za-z])(?=[0-9A-Za-z]*[A-Za-z])[0-9A-Za-z]{4,10})"
    }
  ]
}